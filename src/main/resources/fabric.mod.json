{
  "schemaVersion": 1,
  "id": "statelink",
  "version": "${version}",
  "name": "StateLink",
  "description": "Synchronizes player data and whitelist across servers via MySQL.",
  "authors": [
    "AtsukiGames"
  ],
  "license": "LGPL-3.0-only",
  "icon": "assets/statelink/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.atsukigames.statelink.StateLink"
    ]
  },
  "mixins": [
    "statelink.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "mixinextras": ">=0.5.0",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}",
    "fabric-api": "${fabric_api_dependency}"
  },
  "breaks": {
    "playerdataconnector": "*"
  }
}
